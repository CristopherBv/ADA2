<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cris.AdaDos.controllers.CapturaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox fx:id="viewCarga" alignment="CENTER" spacing="20.0">
        <Label text="Captura de Calificaciones">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" prefHeight="300.0" prefWidth="600.0"
              style="-fx-border-color: #cccccc; -fx-border-style: dashed; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-color: #f9f9f9;">

            <Button fx:id="btnCargarArchivo" text="Subir archivo CSV" onAction="#cargarArchivo"
                    style="-fx-font-size: 14px; -fx-padding: 10 20; -fx-cursor: hand;"/>

            <Label text="Formato requerido: Matrícula, Apellido1, Apellido2, Nombres" textFill="#888888">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Label>
        </VBox>
    </VBox>

    <VBox fx:id="viewTabla" spacing="15.0" visible="false">
        <Label text="Asignar Calificaciones">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <TableView fx:id="tablaAlumnos" editable="true" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colMatricula" text="MATRÍCULA" prefWidth="100.0" />
                <TableColumn fx:id="colApellido1" text="PRIMER APELLIDO" prefWidth="120.0" />
                <TableColumn fx:id="colApellido2" text="SEGUNDO APELLIDO" prefWidth="120.0" />
                <TableColumn fx:id="colNombres" text="NOMBRES" prefWidth="150.0" />

                <TableColumn fx:id="colCalificacion" text="CALIFICACIÓN (0-100)" prefWidth="150.0" style="-fx-alignment: CENTER;" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <Button fx:id="btnGenerarPDF" text="Generar PDF" onAction="#generarPDF"
                    prefWidth="140.0" style="-fx-font-size: 13px; -fx-padding: 8;"/>

            <Button fx:id="btnGenerarCSV" text="Generar CSV" onAction="#generarCSV"
                    prefWidth="140.0" style="-fx-font-size: 13px; -fx-padding: 8;"/>
        </HBox>
    </VBox>

</StackPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cris.AdaDos.controllers.CapturaController">

    <center>
        <StackPane>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <VBox fx:id="viewCarga" alignment="CENTER" spacing="25.0" style="-fx-background-color: white;">
                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="Cargar Lista de Alumnos" textFill="#333333">
                        <font>
                            <Font name="System Bold" size="24.0" />
                        </font>
                    </Label>
                    <Label text="Sube el archivo CSV para comenzar a calificar" textFill="#888888">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                </VBox>

                <VBox alignment="CENTER" maxWidth="650.0" prefHeight="300.0" spacing="20.0"
                      style="-fx-border-color: #007bff; -fx-border-style: dashed; -fx-border-width: 2; -fx-border-radius: 20; -fx-background-color: #f8faff; -fx-background-radius: 20;">

                    <Label text="📄" style="-fx-font-size: 48px;" textFill="#007bff"/>

                    <Label text="Arrastra tu archivo aquí o usa el botón" textFill="#007bff">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <Button fx:id="btnCargarArchivo" text="Seleccionar Archivo CSV" onAction="#cargarArchivo"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 14px;"/>

                    <Label text="Formato: Matrícula, Apellido1, Apellido2, Nombres" textFill="#999999" />
                </VBox>
            </VBox>

            <VBox fx:id="viewTabla" spacing="0.0" visible="false" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8 8 0 0; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                    <Label text="Listado de Alumnos" textFill="#333333">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>
                </HBox>

                <TableView fx:id="tablaAlumnos" editable="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-width: 0;">
                    <columns>
                        <TableColumn fx:id="colMatricula" text="MATRÍCULA" prefWidth="120.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>

                        <TableColumn fx:id="colApellido1" text="PRIMER APELLIDO" prefWidth="120.0" style="-fx-alignment: CENTER_LEFT;"/>
                        <TableColumn fx:id="colApellido2" text="SEGUNDO APELLIDO" prefWidth="120.0" style="-fx-alignment: CENTER_LEFT;"/>

                        <TableColumn fx:id="colNombres" text="NOMBRES" prefWidth="150.0" style="-fx-alignment: CENTER_LEFT;"/>

                        <TableColumn fx:id="colCalificacion" text="CALIFICACIÓN" prefWidth="150.0" style="-fx-alignment: CENTER; -fx-background-color: #fffde7; -fx-border-color: #f0f0f0;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 0 0 8 8; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>

                    <Label text="Exportar reporte:" textFill="#666666" style="-fx-font-size: 13px;">
                        <HBox.margin>
                            <Insets right="10.0" />
                        </HBox.margin>
                    </Label>

                    <Button fx:id="btnGenerarPDF" text="Exportar PDF" onAction="#generarPDF"
                            prefWidth="120.0" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"/>

                    <Button fx:id="btnGenerarCSV" text="Exportar CSV" onAction="#generarCSV"
                            prefWidth="120.0" style="-fx-cursor: hand; -fx-background-radius: 5;"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>